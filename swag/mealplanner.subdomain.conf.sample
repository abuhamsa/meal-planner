## Meal Planner v2 behind SWAG + Authentik forward auth.
## Copy to /config/nginx/proxy-confs/mealplanner.subdomain.conf in your SWAG container
## and change server_name if you use a different subdomain.
##
## Prerequisites in Authentik:
##   1. Applications > Providers > Create > Proxy Provider
##      Mode: "Forward auth (single application)", External host: https://mealplanner.example.com
##   2. Create an Application that uses this provider (bind users/groups to control access).
##   3. Add the application to your outpost (e.g. the embedded outpost).
## Also check that the upstream in SWAG's /config/nginx/authentik-server.conf points to
## your Authentik container (default: authentik-server:9000).

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name mealplanner.*;

    include /config/nginx/ssl.conf;

    client_max_body_size 1m;

    # Authentik forward auth (requires authentik-location.conf in the location block)
    include /config/nginx/authentik-server.conf;

    location / {
        # Every request, including /api/*, is checked against Authentik first. Without a
        # valid session the browser is redirected to the Authentik login. This snippet also
        # sets X-authentik-username, -name, -email, ... for the app.
        include /config/nginx/authentik-location.conf;

        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app meal-planner;
        set $upstream_port 80;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
