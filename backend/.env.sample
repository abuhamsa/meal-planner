# "proxy" (default): SWAG + Authentik authenticate every request. The backend rejects
#                    API calls that don't carry the user header the proxy sets.
# "none":            no auth checks. Local development only.
AUTH_MODE=proxy
# Header that SWAG's authentik-location.conf forwards with the logged-in user.
AUTH_USER_HEADER=X-authentik-username
# Where mealplanner.db is stored. Mounted as a volume in docker-compose.
DATA_DIR=/app/data
